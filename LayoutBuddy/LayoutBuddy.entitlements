<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  LayoutBuddy intentionally runs UNSANDBOXED. A session-wide CGEventTap and
	  reading/writing other apps' text via the Accessibility API are not
	  permitted inside the App Sandbox, so this app is distributed with a
	  Developer ID signature + notarization (not the Mac App Store).
	  The Accessibility and Input Monitoring permissions are granted at runtime
	  via TCC, not declared here.
	-->
</dict>
</plist>
